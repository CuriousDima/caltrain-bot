# Required
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Frontends: set at least one
# Runs the Telegram bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Serves the mobile web page on this port
# WEB_PORT=8080

# Optional
# Model OpenRouter switches to when OPENROUTER_MODEL fails or is retired
# OPENROUTER_FALLBACK_MODEL=openai/gpt-6-luna
# OpenRouter reasoning effort; unset uses the model default (most accurate)
# OPENROUTER_REASONING_EFFORT=none
# DEBUG=0
# Where the web page's usage statistics are stored (default: data/usage.db)
# USAGE_DB_PATH=/var/lib/caltrain-bot/usage.db
